# deploy/Dockerfile.dev -- DEV image for scale-up work.
#
# Layers ONLY additive scale-up code on top of the FROZEN release image. It
# never rebuilds mcr:latest, so the shipped Ubuntu/Windows package can't be
# altered by scale-up work (see scaleup/README.md's isolation contract).
#
# Build (the release image must exist first -- built from the release/app-v1 tag):
#   docker build -f deploy/Dockerfile      -t mcr:latest .
#   docker build -f deploy/Dockerfile.dev  -t mcr:dev    .
#
# Run the scenario engine inside the dev image:
#   docker run --rm mcr:dev python3 tools/run_scenario.py scenarios/harbor_transit_gps_walkoff.json
FROM mcr:latest

# additive scale-up modules
COPY scaleup   /root/maritime-cyber-range/scaleup
COPY scenarios /root/maritime-cyber-range/scenarios
COPY tools/run_scenario.py  /root/maritime-cyber-range/tools/run_scenario.py
COPY tools/site_info.py      /root/maritime-cyber-range/tools/site_info.py
COPY tools/inject_current.py /root/maritime-cyber-range/tools/inject_current.py

# scale-up changes to core package files are previewed here (they ship via the
# normal scaleup -> test_all_4 -> release flow, NOT the frozen baseline). Add
# each such file as the branch changes it.
COPY nodes/monitor/src/templates/index.html /root/maritime-cyber-range/nodes/monitor/src/templates/index.html

# dev-only dependencies go here, kept OUT of the shipped image. The scenario
# engine itself is stdlib-only; add libs here as later modules need them, e.g.:
# RUN /opt/mcr-venv/bin/pip install --no-cache-dir pyyaml matplotlib scikit-learn
