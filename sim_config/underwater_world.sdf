<?xml version="1.0"?>
<!--
  WO-12: self-contained underwater world for the Track U AUV (BlueROV2).

  Design decisions (keep current if edited):
   - graded_buoyancy with water (1025 kg/m^3) BELOW z=0 and air (1 kg/m^3)
     ABOVE z=0. This gives a real water SURFACE at z=0, so the AUV can both
     operate submerged AND surface -- the latter is a prerequisite for WO-17
     (GPS spoofing during surfaced windows). A uniform_fluid_density would
     have made buoyancy apply in "air" too, breaking surfacing.
   - No Fuel (fuel.gazebosim.org) includes: the DAVE ocean worlds pull the
     sea surface / heightmap from Fuel, which needs network and isn't
     reproducible. Everything here is authored inline so `gz sim` works
     offline, matching the project's self-contained goal.
   - <spherical_coordinates> match profiles/bluerov2.json's home, so ArduSub's
     lat/lon origin lines up with the geographic frame the dashboard uses.
   - The bluerov2 model is <include>d here at z=-2 (starts ~2 m submerged), so
     one `gz sim underwater_world.sdf` brings up the whole vehicle. Its
     ArduPilotPlugin then listens on :9100 for FDM from the gps_spoof relay,
     exactly like the surface WAM-V.
   - Resolve models with:
       GZ_SIM_RESOURCE_PATH=<repo>/sim_config/models
-->
<sdf version="1.9">
  <world name="underwater_harbor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Water below z=0, air above z=0 (see header) -->
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025.0</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.0</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>5.5645e-6 22.8758e-6 -42.3884e-6</magnetic_field>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-33.724223</latitude_deg>
      <longitude_deg>150.679736</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.4 0.5 0.6 1.0</ambient>
      <background>0.1 0.25 0.45 1.0</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.95 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 0.3 -1</direction>
    </light>

    <!-- Seabed at 100 m depth: a static box, so there's a real bottom and a
         floor the AUV can hold altitude above. -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -100 0 0 0</pose>
      <link name="seabed_link">
        <collision name="seabed_collision">
          <geometry>
            <box><size>2000 2000 1.0</size></box>
          </geometry>
        </collision>
        <visual name="seabed_visual">
          <geometry>
            <box><size>2000 2000 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.20 0.18 0.12 1</ambient>
            <diffuse>0.25 0.22 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cosmetic translucent water surface at z=0 (visual only, no collision,
         so it never interferes with buoyancy or the vehicle). -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="water_surface_link">
        <visual name="water_surface_visual">
          <transparency>0.75</transparency>
          <geometry>
            <box><size>2000 2000 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.5 0.5</ambient>
            <diffuse>0.0 0.4 0.7 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The AUV, spawned ~2 m below the surface. -->
    <include>
      <uri>model://bluerov2</uri>
      <pose>0 0 -2 0 0 0</pose>
    </include>

  </world>
</sdf>
