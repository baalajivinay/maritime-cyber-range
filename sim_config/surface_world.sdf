<?xml version="1.0"?>
<!--
  WO-21: self-contained surface world for a second surface vehicle (BlueBoat),
  so the harness can boot a non-VRX surface vessel via plain `gz sim` (the way
  the underwater world already works) rather than only the VRX WAM-V stack.

  Design mirrors sim_config/underwater_world.sdf but for a FLOATING vessel:
   - graded_buoyancy: water (1000 kg/m^3) below z=0, air above -> a real
     waterline at z=0 so the hull floats partially submerged.
   - gz-sim-navsat-system + spherical_coordinates at the profile home, so the
     boat's navsat sensor emits a true GPS lat/lon.
   - includes the blueboat at z=0.15 and lets buoyancy settle it to its draft.
   - Resolve models with GZ_SIM_RESOURCE_PATH=<repo>/sim_config/models.
-->
<sdf version="1.9">
  <world name="surface_harbor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000.0</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.0</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>5.5645e-6 22.8758e-6 -42.3884e-6</magnetic_field>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-33.724223</latitude_deg>
      <longitude_deg>150.679736</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.5 0.7 0.9 1.0</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 0.3 -1</direction>
    </light>

    <!-- Cosmetic translucent water surface at z=0 (visual only, no collision). -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="water_surface_link">
        <visual name="water_surface_visual">
          <transparency>0.6</transparency>
          <geometry>
            <box><size>2000 2000 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.5 0.6</ambient>
            <diffuse>0.0 0.4 0.7 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://blueboat</uri>
      <pose>0 0 0.15 0 0 0</pose>
    </include>


    <!-- ground control station (the operator/GCS landmark) -->
    <include>
      <uri>model://ground_station</uri>
      <pose>30 20 0 0 0 0</pose>
    </include>
  </world>
</sdf>
