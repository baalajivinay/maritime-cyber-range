<?xml version="1.0"?>
<!--
  Phase B spike world (2026-08-08): direct clone of
  sim_config/underwater_world.sdf's buoyancy/scene setup, with the
  plane_spike model included instead of bluerov2. Throwaway, not part of
  the vehicle_twins/ system — used only to check ArduPlane arms/holds a
  healthy state underwater before any real geometry investment.
-->
<sdf version="1.9">
  <world name="plane_spike_harbor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025.0</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.0</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>5.5645e-6 22.8758e-6 -42.3884e-6</magnetic_field>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-33.724223</latitude_deg>
      <longitude_deg>150.679736</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.4 0.5 0.6 1.0</ambient>
      <background>0.1 0.25 0.45 1.0</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.95 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 0.3 -1</direction>
    </light>

    <model name="seabed">
      <static>true</static>
      <pose>0 0 -100 0 0 0</pose>
      <link name="seabed_link">
        <collision name="seabed_collision">
          <geometry>
            <box><size>2000 2000 1.0</size></box>
          </geometry>
        </collision>
        <visual name="seabed_visual">
          <geometry>
            <box><size>2000 2000 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.20 0.18 0.12 1</ambient>
            <diffuse>0.25 0.22 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="water_surface_link">
        <visual name="water_surface_visual">
          <transparency>0.75</transparency>
          <geometry>
            <box><size>2000 2000 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.5 0.5</ambient>
            <diffuse>0.0 0.4 0.7 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The spike vehicle, spawned ~2 m below the surface. -->
    <include>
      <uri>model://plane_spike</uri>
      <pose>0 0 -2 0 0 0</pose>
    </include>

    <!-- ground control station (the operator/GCS landmark) -->
    <include>
      <uri>model://ground_station</uri>
      <pose>30 20 0 0 0 0</pose>
    </include>
  </world>
</sdf>
