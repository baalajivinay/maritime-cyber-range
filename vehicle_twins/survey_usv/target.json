{
  "name": "survey_usv",
  "description": "Digital twin of a small Indian coastal/harbour hydrographic-survey USV (representative ~5 m autonomous catamaran class, e.g. NIOT/academic survey platforms), as fielded with a stock ArduRover-class autopilot. Surface vessel: GPS + AIS + MAVLink command link present. Boot via tools/run_vehicle.sh vehicle_twins/survey_usv up.",
  "domain": "surface",
  "authorized": true,
  "mavlink": {
    "connection": "udpin:127.0.0.1:14554",
    "source_system": 255
  },
  "attacks": {
    "gps_spoof": {
      "enabled": true,
      "method": "fdm_relay",
      "bind": [
        "127.0.0.1",
        9002
      ],
      "gazebo_addr": [
        "127.0.0.1",
        9100
      ],
      "relay_fifo": "/tmp/mcr_run/survey_usv/relay.fifo",
      "profile": "step",
      "step_offset_m": 50.0,
      "direction_deg": 90.0
    },
    "ais_spoof": {
      "enabled": true,
      "udp_addr": [
        "127.0.0.1",
        10110
      ],
      "own_mmsi": "419000567",
      "modes": [
        "ghost",
        "impersonate"
      ]
    },
    "c2_replay": {
      "enabled": true,
      "target_mode_for_injection": "HOLD",
      "allow_arm_and_actuate": true,
      "rc_throttle_pwm": 1700,
      "rc_steering_pwm": 1500,
      "duration_s": 8.0
    }
  },
  "timing": {
    "settle_s": 5.0,
    "window_s": 20.0
  }
}
