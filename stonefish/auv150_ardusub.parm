# ArduSub ExternalNav config for the Stonefish-bridged AUV-150.
# Submerged AUV fixes horizontal position from acoustic/USBL (ExternalNav),
# delivered as VISION_POSITION_ESTIMATE by tools/stonefish_extnav.py -- NOT GPS.
# This is what makes the acoustic-spoof attack meaningful: forging the USBL
# feed walks the vehicle's believed position off its true Stonefish track.

EK2_ENABLE 0
EK3_ENABLE 1
AHRS_EKF_TYPE 3

# No GPS underwater -- disable it so the EKF relies on ExternalNav.
GPS_TYPE 0
SIM_GPS_DISABLE 1

# EKF source set 1: horizontal position/velocity + yaw from ExternalNav,
# depth from the pressure/baro channel.
VISO_TYPE 1
EK3_SRC1_POSXY 6
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 6
EK3_SRC1_YAW 6
COMPASS_USE 0
COMPASS_USE2 0
COMPASS_USE3 0

# Sim-bridge conveniences: relax arming prechecks, no battery failsafe.
ARMING_CHECK 0
BATT_MONITOR 0
FS_OPTIONS 0
SIM_BARO_RND 0.01
